# Run node scripts/init-local.mjs to generate independent random credentials.
POSTGRES_PASSWORD=replace-with-random-password
FILEMATE_DATABASE_URL=postgresql+psycopg://filemate:replace-with-random-password@127.0.0.1:54329/filemate
FILEMATE_SERVICE_URL=http://127.0.0.1:8765
FILEMATE_TOOL_TOKEN=replace-with-random-tool-token
FILEMATE_ADMIN_TOKEN=replace-with-different-random-admin-token
# DEEPSEEK_API_KEY=your-provider-key
# Single model generation limits (include reasoning and tool arguments).
# Optional; invalid values fall back to defaults. Restart npm start after changes.
FILEMATE_GENERATION_TIMEOUT_MS=120000
FILEMATE_GENERATION_MAX_CHARS=24000
